# MILD / AprilVINS upload backend configuration.
# Copy this file to backend/.env for local deployment. Do not commit backend/.env.

# Local job storage. Raw uploads and generated outputs are retained here.
MILD_UPLOAD_ROOT=backend/runtime/jobs

# Comma-separated browser origins allowed to call this API.
MILD_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,https://mild-web.github.io

# Upload limit in bytes. Default below is 20 GiB.
MILD_MAX_UPLOAD_BYTES=21474836480

# Keep raw uploaded recordings after processing. The public web form explains this retention.
MILD_RETAIN_UPLOADS=true

# If no real AprilVINS command is configured, generate a deterministic mock trajectory
# package so that the whole upload/status/download loop can be tested unattended.
MILD_MOCK_WITHOUT_COMMAND=true

# Optional real AprilVINS command template. It is executed with shell=False after
# Python shlex splitting. Available placeholders:
#   {input_file}   uploaded archive path
#   {job_dir}      per-job directory
#   {output_dir}   directory for generated outputs
#   {tag_size_m}   tag size supplied by user
#   {sensor_route} uploaded sensor route
# Example:
# APRILVINS_COMMAND_TEMPLATE=/opt/aprilvins/run_x5.sh --input {input_file} --output {output_dir} --tag-size {tag_size_m}
APRILVINS_COMMAND_TEMPLATE=

# Optional S3-compatible object storage placeholders for a future cloud deployment.
# The first MVP uses local storage by default, so these may remain empty.
MILD_STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

